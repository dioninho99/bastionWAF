# Keep reachable only from the admin network; the default is suitable for an SSH tunnel.
BASTION_ADMIN_BIND=127.0.0.1
BASTION_PUBLIC_BIND=0.0.0.0
# Optional public origin when the admin UI is served behind a TLS reverse proxy.
# Bastion's public admin URL:
BASTION_ADMIN_ORIGIN=https://web.cyberpotato.ch
BASTION_ADMIN_SECURE_COOKIE=false

# Set true only when trusted private-network backends are required.
BASTION_ALLOW_PRIVATE_UPSTREAMS=false

# Optional dedicated Prometheus token. Never reuse the admin password.
# Generate at least 32 random characters and restrict access to /metrics.
BASTION_METRICS_TOKEN=

# Active upstream HEAD checks. Interval is in seconds (5–300).
BASTION_UPSTREAM_HEALTH_INTERVAL=30

# Optional wildcard certificates through Cloudflare DNS-01.
# Use a scoped API token with Zone:DNS:Edit only.
BASTION_ACME_DNS_PROVIDER=
BASTION_ACME_DNS_API_TOKEN=
BASTION_ACME_DOMAINS=

# Automatic Let's Encrypt certificates: set a real email address.
# Enabling this activates HTTPS and accepts the Let's Encrypt terms of service.
BASTION_ACME_EMAIL=

# Alternatively, place a PEM certificate and key under ./certs:
# BASTION_TLS_CERT=/certs/fullchain.pem
# BASTION_TLS_KEY=/certs/privkey.pem
