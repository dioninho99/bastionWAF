# Keep reachable only from the admin network; the default is suitable for an SSH tunnel.
BASTION_ADMIN_BIND=127.0.0.1
BASTION_PUBLIC_BIND=0.0.0.0

# Automatic Let's Encrypt certificates: set a real email address.
# Enabling this activates HTTPS and accepts the Let's Encrypt terms of service.
BASTION_ACME_EMAIL=

# Alternatively, place a PEM certificate and key under ./certs:
# BASTION_TLS_CERT=/certs/fullchain.pem
# BASTION_TLS_KEY=/certs/privkey.pem
