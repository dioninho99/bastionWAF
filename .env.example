# Nur im Admin-Netz erreichbar machen; Standard erlaubt SSH-Tunnel.
BASTION_ADMIN_BIND=127.0.0.1
BASTION_PUBLIC_BIND=0.0.0.0

# Automatische Let's-Encrypt-Zertifikate: echte Mailadresse setzen.
# Die Nutzung aktiviert HTTPS und akzeptiert die Let's-Encrypt-Nutzungsbedingungen.
BASTION_ACME_EMAIL=

# Alternativ PEM-Zertifikat und Key unter ./certs ablegen:
# BASTION_TLS_CERT=/certs/fullchain.pem
# BASTION_TLS_KEY=/certs/privkey.pem
